# Stellarouter smart-contract — example environment (SAFE to commit)
# Copy to `.env` and fill in the values. `.env` is git-ignored.

STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Deployer / treasury account
DEPLOYER_PUBLIC_KEY=G...
DEPLOYER_SECRET_KEY=S...   # SECRET — never commit
