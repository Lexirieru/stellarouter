# ─── Stellarouter gateway — x402 config (SAFE to commit; copy to .env) ─────────
PORT=3001
STELLAR_NETWORK=stellar:testnet
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet

# Recipient: a G... account WITH a USDC trustline (receives the per-call payments).
# Our deployer account already has a USDC trustline, so it can be used:
STELLAR_RECIPIENT=GDYS2IMCFRSBIR2DDJV2E6TLEQI5A45SEBICIIXUDIAQIOC5IRUR7UTC

# OZ Channels API key (REQUIRED) — testnet: https://channels.openzeppelin.com/testnet/gen
OZ_API_KEY=

# Flat price per call (USDC, 7 decimals; "$0.005" is auto-converted)
X402_PRICE=$0.005

# Upstream LLM (OpenAI-compatible). Empty = the gateway returns a mock completion.
# Direct OpenRouter:  UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
# Via 9router:        UPSTREAM_BASE_URL=http://localhost:20127/v1
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
# 9router namespaces models by provider — prefix model ids (leave empty for direct).
# UPSTREAM_MODEL_PREFIX=openrouter/
UPSTREAM_MODEL_PREFIX=
# Cap on completion tokens when the caller doesn't set max_tokens (flat-price x402
# must bound the completion size). Default 512.
# UPSTREAM_MAX_TOKENS=512
# Model catalog for the UI (separate from chat routing). Default OpenRouter.
MODELS_BASE_URL=https://openrouter.ai/api/v1
# Testnet: only these models are enabled (free on OpenRouter). The rest of the
# catalog is labelled "available in mainnet". On STELLAR_NETWORK=stellar:pubnet
# every model is enabled.
# TESTNET_MODELS=minimax/minimax-m3:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free

# ─── Human (prepaid) door — credits contract on testnet ──────────────────────
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
CREDITS_CONTRACT_ID=CAEFFQAL6SGQF6OV5BOBE23NAC2T7WXOUUE5XRDOH2KRN2HXRMDXA7RE
# Gateway admin secret (= the contract admin) used to sign debit(). SECRET.
GATEWAY_ADMIN_SECRET=
# Fee-bump sponsor for gasless deposits/withdrawals. Keep this SEPARATE from the
# admin key where you can — it only pays fees, so a compromise costs fee money
# rather than admin powers (security review C-2). Falls back to the admin key.
SPONSOR_SECRET=
# SQLite paths for the key store / usage logs (use /tmp/... on serverless).
# KEYS_DB_PATH=data/keys.db
# LOGS_DB_PATH=data/logs.db

# ─── Only for examples/client.js and the Playground demo agent (buyer) ────────
# S... key with a USDC trustline + balance. NEVER commit .env (already ignored).
PAYER_SECRET_KEY=
GATEWAY_URL=http://localhost:3001

# Demo API key for the human door (apiKey -> the user's Stellar address). Testing only.
DEMO_API_KEY=sk-stellarouter-demo
DEMO_USER_ADDRESS=G...   # a user address that has already deposited credit
